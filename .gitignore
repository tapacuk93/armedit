# build output
*.o
*.elf
*.bin
*.img
build/
app/tty
app/window
backend/armeditd

# secrets - never commit credentials of any kind
*.token
*.pem
*.key
.env
.env.*
secrets/

# gradle
backend-java/.gradle/
backend-java/build/
backend-java/gradlew
backend-java/gradle/

# workspaces hold users' text and audit logs
workspaces/

# Build output is ignored above, and ops/ is not build output: those blobs are
# the operations the consortium agreed to ship, and they are the only reason
# the editor can answer without a network. Committed with their source and the
# votes that approved them.
!ops/*.bin

# The EFI system disk is fifty megabytes of mostly nothing, rebuilt by
# tools/mkesp.sh whenever the application changes.
*.img
*.dmg
